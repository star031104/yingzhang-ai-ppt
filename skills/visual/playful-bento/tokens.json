{
  "layoutProfile": "playful-bento",
  "typographyMood": "friendly",
  "densityBias": "balanced",
  "fontFamily": "Microsoft YaHei",
  "radius": {
    "card": 24,
    "panel": 30
  },
  "palette": {
    "bg": "#F6F4FF",
    "ink": "#211D35",
    "primary": "#6E55E8",
    "accent": "#8CE3C7",
    "deep": "#2E2850",
    "line": "#E3DFF3"
  },
  "grid": {
    "columns": 12,
    "margin": {
      "x": 60,
      "top": 48,
      "bottom": 40
    },
    "gutter": 16
  },
  "typeScale": {
    "display": 70,
    "title": 48,
    "subtitle": 22,
    "body": 20,
    "caption": 11
  },
  "density": "balanced",
  "decoration": {
    "motifs": [
      "dots",
      "orb"
    ],
    "intensity": "bold"
  },
  "titleStyle": {
    "align": "left",
    "weight": 800,
    "tracking": -0.03,
    "case": "none",
    "font": "sans",
    "accent": "none"
  },
  "chartStyle": {
    "palette": [
      "primary",
      "accent",
      "deep",
      "#FF8A65"
    ],
    "gridlines": "none",
    "dataLabels": true,
    "barRadius": 8
  },
  "iconStyle": {
    "use": true,
    "stroke": 2,
    "container": "square"
  },
  "forbidden": [
    "decorative-quote",
    "all-caps"
  ]
}
