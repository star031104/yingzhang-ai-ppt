{
  "layoutProfile": "editorial-story",
  "typographyMood": "editorial",
  "densityBias": "airy",
  "fontFamily": "Microsoft YaHei",
  "radius": {
    "card": 2,
    "panel": 4
  },
  "palette": {
    "bg": "#F6F0E7",
    "ink": "#231F20",
    "primary": "#9D2C3A",
    "accent": "#D6A85F",
    "deep": "#2A2527",
    "line": "#D8CDC0"
  },
  "grid": {
    "columns": 12,
    "margin": {
      "x": 88,
      "top": 60,
      "bottom": 48
    },
    "gutter": 28
  },
  "typeScale": {
    "display": 68,
    "title": 48,
    "subtitle": 24,
    "body": 21,
    "caption": 11
  },
  "density": "airy",
  "decoration": {
    "motifs": [
      "quote-mark",
      "frame"
    ],
    "intensity": "subtle"
  },
  "titleStyle": {
    "align": "left",
    "weight": 700,
    "tracking": -0.02,
    "case": "none",
    "font": "serif",
    "accent": "underline"
  },
  "chartStyle": {
    "palette": [
      "primary",
      "accent",
      "deep",
      "muted"
    ],
    "gridlines": "none",
    "dataLabels": true,
    "barRadius": 0
  },
  "iconStyle": {
    "use": false,
    "stroke": 1.5,
    "container": "none"
  },
  "forbidden": [
    "icons",
    "orb",
    "glow",
    "shadow"
  ]
}
