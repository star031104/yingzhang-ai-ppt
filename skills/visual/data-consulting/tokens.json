{
  "layoutProfile": "data-consulting",
  "typographyMood": "executive",
  "densityBias": "compact",
  "fontFamily": "Microsoft YaHei",
  "radius": {
    "card": 8,
    "panel": 12
  },
  "palette": {
    "bg": "#F5F8FA",
    "ink": "#102A43",
    "primary": "#007A78",
    "accent": "#F0B429",
    "deep": "#173F5F",
    "line": "#D9E2EC"
  },
  "grid": {
    "columns": 12,
    "margin": {
      "x": 64,
      "top": 48,
      "bottom": 40
    },
    "gutter": 18
  },
  "typeScale": {
    "display": 60,
    "title": 40,
    "subtitle": 20,
    "body": 18,
    "caption": 11
  },
  "density": "compact",
  "decoration": {
    "motifs": [
      "rule"
    ],
    "intensity": "subtle"
  },
  "titleStyle": {
    "align": "left",
    "weight": 700,
    "tracking": -0.02,
    "case": "none",
    "font": "sans",
    "accent": "kicker"
  },
  "chartStyle": {
    "palette": [
      "primary",
      "deep",
      "accent",
      "muted"
    ],
    "gridlines": "horizontal",
    "dataLabels": true,
    "barRadius": 1
  },
  "iconStyle": {
    "use": true,
    "stroke": 1.75,
    "container": "none"
  },
  "forbidden": [
    "gradient",
    "orb",
    "glow",
    "decorative-quote"
  ]
}
