{
  "layoutProfile": "swiss-grid",
  "typographyMood": "geometric",
  "densityBias": "balanced",
  "fontFamily": "Microsoft YaHei",
  "radius": {
    "card": 6,
    "panel": 8
  },
  "palette": {
    "bg": "#F5F5F2",
    "ink": "#111111",
    "primary": "#E23D28",
    "accent": "#F3C84B",
    "deep": "#151515",
    "line": "#D8D8D2"
  },
  "grid": {
    "columns": 12,
    "margin": {
      "x": 72,
      "top": 56,
      "bottom": 44
    },
    "gutter": 24
  },
  "typeScale": {
    "display": 72,
    "title": 50,
    "subtitle": 22,
    "body": 20,
    "caption": 11
  },
  "density": "balanced",
  "decoration": {
    "motifs": [
      "grid-lines"
    ],
    "intensity": "subtle"
  },
  "titleStyle": {
    "align": "left",
    "weight": 800,
    "tracking": -0.04,
    "case": "none",
    "font": "sans",
    "accent": "bar"
  },
  "chartStyle": {
    "palette": [
      "primary",
      "ink",
      "accent",
      "muted"
    ],
    "gridlines": "horizontal",
    "dataLabels": true,
    "barRadius": 0
  },
  "iconStyle": {
    "use": true,
    "stroke": 2,
    "container": "none"
  },
  "forbidden": [
    "gradient",
    "shadow",
    "orb",
    "glow",
    "decorative-quote",
    "rounded-card"
