{
  "layoutProfile": "oriental-minimal",
  "typographyMood": "refined",
  "densityBias": "airy",
  "fontFamily": "Microsoft YaHei",
  "radius": {
    "card": 4,
    "panel": 6
  },
  "palette": {
    "bg": "#F7F2E8",
    "ink": "#20211F",
    "primary": "#9A3B2E",
    "accent": "#C69C55",
    "deep": "#26312E",
    "line": "#D9D0C1"
  },
  "grid": {
    "columns": 12,
    "margin": {
      "x": 96,
      "top": 64,
      "bottom": 50
    },
    "gutter": 32
  },
  "typeScale": {
    "display": 66,
    "title": 46,
    "subtitle": 22,
    "body": 20,
    "caption": 11
  },
  "density": "airy",
  "decoration": {
    "motifs": [
      "seal",
      "rule"
    ],
    "intensity": "subtle"
  },
  "titleStyle": {
    "align": "left",
    "weight": 600,
    "tracking": 0.02,
    "case": "none",
    "font": "serif",
    "accent": "none"
  },
  "chartStyle": {
    "palette": [
      "primary",
      "deep",
      "accent",
      "muted"
    ],
    "gridlines": "none",
    "dataLabels": true,
    "barRadius": 0
  },
  "iconStyle": {
    "use": true,
    "stroke": 1.25,
    "container": "none"
  },
  "forbidden": [
    "gradient",
    "shadow",
    "orb",
    "glow",
    "rounded-card"
  ]
}
