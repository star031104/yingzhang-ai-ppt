SLIDEFORGE_DATABASE_URL=sqlite:///./runtime/data/yingzhang.db
SLIDEFORGE_ARTIFACT_ROOT=./runtime/artifacts
SLIDEFORGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SLIDEFORGE_VAULT_KEY=set-a-stable-secret-in-headless-environments
# 默认本地单用户：无需账号、密码或登录。不要把 .env 提交到仓库。
SLIDEFORGE_PUBLIC_TEST_MODE=false
SLIDEFORGE_PUBLIC_SESSION_HOURS=12
SLIDEFORGE_PUBLIC_RATE_LIMIT_PER_MINUTE=180
SLIDEFORGE_PUBLIC_GENERATION_LIMIT_PER_10_MINUTES=12
SLIDEFORGE_PUBLIC_UPLOAD_LIMIT_MB=25
# 整稿生成时同时渲染的页面数；建议 1-4，默认 2。
SLIDEFORGE_RENDER_CONCURRENCY=2
# 每轮样张/全稿最多等待可选配图的秒数；超时保留远程任务，继续生成 PPT。
SLIDEFORGE_OPTIONAL_IMAGE_WAIT_SECONDS=45
# 完全本地模式：仅允许连接本机模型服务，并禁用联网素材与远程技能导入。
SLIDEFORGE_LOCAL_ONLY_MODE=false

# 本地个人工作区保持关闭账号模式。
SLIDEFORGE_PRIVATE_ACCOUNTS_MODE=false
# 桌面验收使用的 LibreOffice 可执行文件路径；不填时自动查找。
# SLIDEFORGE_OFFICE_EXECUTABLE=C:/Program Files/LibreOffice/program/soffice.exe
